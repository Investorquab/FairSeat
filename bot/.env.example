# FairSeat bot env (copy to .env, never commit). .env is git-ignored.

# Telegram bot token from @BotFather (secret).
BOT_TOKEN=

# Chain / contracts (filled from contracts/deployments/<network>.json).
CHAIN_ID=97
RPC_URL=https://bsc-testnet-rpc.publicnode.com
REGISTRY_ADDRESS=
VERIFIER_ADDRESS=
VAULT_ADDRESS=

# Operator key: the backend wallet that commits off-chain-tap entrants and can call
# resolve(). On testnet this is the throwaway deployer key. On mainnet the project
# owner supplies a dedicated operator key. Used ONLY for FairSeat's own transactions —
# the bot NEVER signs for users and NEVER stores user wallet sessions.
OPERATOR_KEY=

# Where the SQLite database file lives.
DB_PATH=./fairseat.db

# When running behind the agent proxy in this cloud env (not needed on a normal server):
# http_proxy=http://127.0.0.1:42319
