# FairSeat backend (Telegram bot + HTTP API + chain-watcher).
# Copy to .env and fill in. .env is git-ignored. Defaults target BNB Chain MAINNET.

# Telegram bot token from @BotFather. Optional — leave empty to run the API + website only
# (no Telegram). Regenerate it in BotFather if it is ever exposed.
BOT_TOKEN=

# Network: mainnet = 56. For the testnet setup, set CHAIN_ID=97 and a testnet RPC below.
CHAIN_ID=56
RPC_URL=https://bsc-dataseed.bnbchain.org

# Contracts. REGISTRY_ADDRESS is the real Binance / SPACE ID "Agent ID" registry on BNB mainnet.
# The FairSeat contract addresses are printed by the deploy script
# (contracts/deployments/<network>.json) — paste them here after deploying.
REGISTRY_ADDRESS=0x60B9262456dE011F7d15a54CdD8c48bAaa8B022F
VERIFIER_ADDRESS=
VAULT_ADDRESS=
POLL_ADDRESS=
DISTRIBUTOR_ADDRESS=

# Operator key: FairSeat's OWN backend wallet. It can ONLY submit off-chain-tap entrants/votes
# (commitEntrants / commitVotes) and call the permissionless resolve() as a convenience. It can
# NEVER move or withdraw user funds. Fund it with a little BNB for gas. Never a user's key.
OPERATOR_KEY=

# Average seconds per block, used to size a giveaway's draw block safely after its entry window.
# BNB mainnet ~0.75s, testnet ~0.45s.
BLOCK_TIME_SEC=0.75

# Local SQLite database file and API port.
DB_PATH=./fairseat.db
API_PORT=8787
