# FairSeat contracts (Solidity + Hardhat).
# Copy to .env and fill in. .env is git-ignored. Unit tests on the local Hardhat network need none
# of these — they are only for deploying/verifying on a live network. Defaults target BNB mainnet.

# RPC endpoints.
BSC_MAINNET_RPC=https://bsc-rpc.publicnode.com
BSC_TESTNET_RPC=https://bsc-testnet-rpc.publicnode.com

# Deployer private key. For MAINNET this is the project owner's key (keep it safe, never commit).
# For testnet, use a throwaway key. With or without the 0x prefix.
DEPLOYER_KEY=

# The FairSeat backend operator address (allowed to commit off-chain-tap entrants/votes; it can
# NEVER move funds). Defaults to the deployer address if left empty.
OPERATOR_ADDRESS=

# Optional: override the Agent ID registry. Left empty, deploy uses the REAL registry on mainnet
# (0x60B9262456dE011F7d15a54cdd8c48bAaa8B022f) and a disposable mock on any test network.
REGISTRY_ADDRESS=

# BscScan API key, for `hardhat verify` to publish and verify the source on BscScan.
BSCSCAN_API_KEY=
