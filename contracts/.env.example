# FairSeat contracts — environment variables (copy to .env, never commit real values).
# .env is git-ignored. These are only needed for deploying/verifying on a live network;
# unit tests on the local Hardhat network need none of them.

# RPC endpoints (defaults are public nodes; override if you have your own).
BSC_TESTNET_RPC=https://bsc-testnet-rpc.publicnode.com
BSC_MAINNET_RPC=https://bsc-rpc.publicnode.com

# Deployer private key WITHOUT 0x prefix is also fine; with 0x works too.
# Use a THROWAWAY key for testnet. For mainnet, the project owner supplies their own.
DEPLOYER_KEY=

# BscScan API key, for `hardhat verify` to publish source.
BSCSCAN_API_KEY=
